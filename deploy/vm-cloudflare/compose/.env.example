# Copy to .env (git-ignored) or export before running bin/bluegreen.sh.
# Real secrets go in /etc/paperclip/secrets.env (0600), never here.

# Image promoted from staging. Prefer a digest.
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest

# Board origin, behind Cloudflare Access.
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
# Machine hostname (Access bypass): agents, remote runner, chat webhooks.
PAPERCLIP_API_URL=https://paperclip-api.example.com
PAPERCLIP_RUNNER_PUBLIC_URL=wss://paperclip-api.example.com
PAPERCLIP_CHAT_WEBHOOK_PUBLIC_URL=https://paperclip-api.example.com

PAPERCLIP_SECRETS_ENV_FILE=/etc/paperclip/secrets.env
PAPERCLIP_INSTANCE_ENV_FILE=/etc/paperclip/instance.env
PAPERCLIP_HOME_VOLUME=paperclip-home
PAPERCLIP_NETWORK=paperclip

# Set per colour by bin/bluegreen.sh; defaults here only make
# `docker compose config` render.
PAPERCLIP_COLOR=blue
PAPERCLIP_HOST_PORT=3101
PAPERCLIP_SCHEDULER_ENABLED=false

# edge.compose.yml
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token
POSTGRES_PASSWORD=replace-me-only-for-localdb-profile
